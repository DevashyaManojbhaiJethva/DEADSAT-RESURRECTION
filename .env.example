# DeadSat Resurrection — Three-Node Deployment Configuration
# ===========================================================
# Copy to `.env`. Every value is optional; the defaults run everything on
# localhost for single-machine development.
#
# THREE-NODE DEPLOYMENT:
# 
# Raspberry Pi #1 (Core Node):
#   - Runs AI-1, AI-2, crypto, recovery, emulator, database
#   - Main API server on port 8000
#   - Receives RF data from Pi #2
#   - Serves frontend via WebSocket
#
# Raspberry Pi #2 (RF Node):
#   - Runs RTL-SDR acquisition service on port 8002
#   - Sends RF frames to Pi #1 via /rf/ingest
#   - Lightweight, headless operation
#
# Laptop (Operator Dashboard):
#   - Runs React/Vite frontend
#   - Connects to Pi #1 for all data
#   - Visualizes RF data via WebSocket
#
# See config.py for the full list and the two-Pi topology diagram.

# ── Pi #1 — AI-1, AI-2, crypto, emulator, API ────────────────────────
# Bind address. 0.0.0.0 accepts LAN traffic from Pi #2 and the operator
# browser; 127.0.0.1 keeps it loopback-only.
DEADSAT_API_HOST="0.0.0.0"
DEADSAT_API_PORT="8000"

# The address OTHER machines use to reach Pi #1. Must be the LAN IP in a
# two-Pi setup — "localhost" only works when everything is on one box.
DEADSAT_PUBLIC_HOST="localhost"
# DEADSAT_PUBLIC_HOST="192.168.1.50"

# ── Pi #2 — RF ground station (RTL-SDR) ──────────────────────────────
# Where Pi #1 reaches the RF service. Pi #1 proxies it at /rf/status so the
# browser only ever talks to one origin.
DEADSAT_RF_BASE="http://localhost:8002"
# DEADSAT_RF_BASE="http://192.168.1.51:8002"
DEADSAT_RF_TIMEOUT_S="3.0"

# RF acquisition parameters (for Pi #2 service)
RF_CENTER_FREQUENCY_HZ="137900000.0"  # 137.9 MHz for Meteor-M2-3/4
RF_SAMPLE_RATE="2400000"              # 2.4 MSPS
RF_GAIN="49.6"                        # RF gain in dB
RF_STREAM_INTERVAL_S="1.0"            # RF frame transmission interval
RF_MOCK_MODE="false"                  # Set to "true" to use mock RTL-SDR (no hardware)

# Ground station location for satellite tracking (configurable for your location)
GROUND_LAT="23.03"                    # Latitude in degrees (default: Ahmedabad, India)
GROUND_LON="72.58"                    # Longitude in degrees
GROUND_ELEV_M="53"                    # Elevation in meters
RF_LOCATION_LAT=""                     # Optional RF location override
RF_LOCATION_LON=""                     # Optional RF location override

# Default satellite for RF tracking
DEFAULT_NORAD_ID="59051"              # Meteor-M2-4 (change for other satellites)
RF_TARGET_NORAD_ID="59051"            # RF/Doppler target; defaults to DEFAULT_NORAD_ID

# ── Redis (replay-protection nonce store) ────────────────────────────
# "localhost" only works when redis runs on the same box as this process.
# docker-compose.yml overrides these to DEADSAT_REDIS_HOST=redis (the
# compose service name) automatically — you don't need to edit this file
# for the Docker setup, only for a non-Docker multi-host deployment.
DEADSAT_REDIS_HOST="localhost"
DEADSAT_REDIS_PORT="6379"

# ── Frontend / CORS ──────────────────────────────────────────────────
#
# !! READ THIS IF THE DASHBOARD LOADS BUT EVERY PANEL IS EMPTY !!
#
# This MUST list the origin the operator's browser actually uses. The value
# below is loopback-only and is correct ONLY when the browser runs on this
# same machine.
#
# The trap: DEADSAT_API_HOST above defaults to 0.0.0.0, so the API accepts
# LAN traffic. `npm run dev` also binds 0.0.0.0:3000. If the operator then
# opens http://<LAN-IP>:3000, that origin is NOT in the list below and the
# browser blocks every REST call.
#
# It does not look like a CORS problem. WebSockets are exempt from CORS, so
# /ws/telemetry connects, live frames stream, and the header badge reads
# "LIVE TM" with a healthy link count — while the TLE/orbital panel, catalog,
# crypto status, ledger, alerts, pipeline status, /system/links detail and RF
# spectrum all fail silently inside their .catch() and stay blank.
#
# config.print_banner() warns at startup when this combination is detected.
#
# Two-Pi / LAN demo — set the operator machine's real origin:
#   DEADSAT_CORS_ORIGINS="http://192.168.1.60:3000"
# Several operators, or a mixed local + LAN setup:
#   DEADSAT_CORS_ORIGINS="http://localhost:3000,http://192.168.1.60:3000"
#
# Do NOT use "*" on a routable network — the API exposes fault injection,
# recovery and reset with no authentication unless DEADSAT_API_KEY is set.
DEADSAT_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173"

# ── Security ─────────────────────────────────────────────────────────
# Shared secret for mutating endpoints. Empty = no authentication.
# Set this (and VITE_API_KEY in frontend/.env) for any LAN deployment.
DEADSAT_API_KEY=""

# JWT login (required for the dashboard's protected history and event streams).
# Generate a high-entropy DEADSAT_JWT_SECRET outside the repository.  Operators
# are configured here only at deployment; no application users are seeded.
DEADSAT_JWT_SECRET=""
DEADSAT_JWT_ISSUER=""
DEADSAT_JWT_AUDIENCE=""
DEADSAT_JWT_TTL_S="900"
DEADSAT_JWT_WS_TTL_S="60"
# JSON object keyed by username. password_hash uses:
# scrypt$N$r$p$base64url_salt$base64url_digest
# Example shape only (not usable credentials):
# DEADSAT_AUTH_USERS_JSON='{"operator":{"sub":"operator-id","role":"operator","permissions":["history:read"],"password_hash":"scrypt$..."}}'
DEADSAT_AUTH_USERS_JSON="{}"

# Require a successful /crypto/verify before the emulator applies a recovery
# procedure. This is the security gate the project is built around.
DEADSAT_REQUIRE_VERIFICATION="1"

# Allow the agent's mock-signing fallback when the crypto service is down.
# OFF by default — mock signatures are NOT cryptographically valid.
DEADSAT_ALLOW_MOCK_SIGNING="0"

# Allow uplink with no ground-contact window (bench/demo mode).
DEADSAT_ALLOW_UPLINK_WITHOUT_CONTACT="1"

# ── Satellite ────────────────────────────────────────────────────────
DEADSAT_NORAD_ID="28654"
DEADSAT_SATELLITE_ID="DEADSAT-1"
DEADSAT_TICK_S="1.0"

# ── Optional external APIs ───────────────────────────────────────────
N2YO_API_KEY=""

# ── Pi #2 Service Configuration (for running RF service directly) ──
# These are used when running rf/service.py directly on Pi #2
RF_SERVICE_HOST="0.0.0.0"
RF_SERVICE_PORT="8002"
