# DeadSat Resurrection — frontend configuration
# Copy to `.env` and set for your deployment.

# Base URL of the Pi #1 API (AI-1, AI-2, crypto, emulator).
# Leave unset to default to the current page host on port 8000, which works
# when the dev server and backend run on the same machine.
#
#   Single machine : http://localhost:8000
#   Two-Pi setup   : http://<PI1_LAN_IP>:8000   e.g. http://192.168.1.50:8000
VITE_API_BASE="http://localhost:8000"

# Optional shared secret. Must match DEADSAT_API_KEY on Pi #1.
# Leave empty when the backend runs without authentication.
VITE_API_KEY=""
